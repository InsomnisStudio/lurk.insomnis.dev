---
import Base from '../layouts/Base.astro';
import Feed from '../components/Feed.astro';
import CodeTabs from '../components/CodeTabs.astro';
import UrlBuilder from '../components/UrlBuilder.astro';
import Pricing from '../components/Pricing.astro';
import { PLATFORMS, CONTACT_EMAIL, DEMO_WS_URL } from '../config';
import { t, path, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const c = t[lang];
const fromPrice = Math.min(...PLATFORMS.map((p) => p.price));
const platformList = new Intl.ListFormat(lang, { type: 'conjunction' }).format(PLATFORMS.map((p) => p.name));

// "Lurk" alone is also lurk.org and others: name the entity as the API it is.
const organization = new URL('/#organization', Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': organization,
			name: 'Lurk',
			alternateName: 'Lurk API',
			url: new URL('/', Astro.site).href,
			logo: new URL('/favicon.svg', Astro.site).href,
			email: CONTACT_EMAIL,
		},
		{
			'@type': 'WebSite',
			name: 'Lurk',
			url: new URL('/', Astro.site).href,
			inLanguage: ['es', 'en'],
			publisher: { '@id': organization },
		},
		{
			'@type': 'WebAPI',
			name: 'Lurk API',
			alternateName: 'Lurk: real-time listings API for Vinted, Wallapop, Milanuncios and Todocolección',
			description: c.home.description,
			url: new URL(path(lang), Astro.site).href,
			documentation: new URL(path(lang, 'docs'), Astro.site).href,
			provider: { '@id': organization },
			offers: PLATFORMS.map((p) => ({ '@type': 'Offer', name: `${p.name} API`, price: p.price, priceCurrency: 'EUR' })),
		},
		{
			'@type': 'FAQPage',
			mainEntity: c.faq.items.map(([q, a]) => ({
				'@type': 'Question',
				name: q,
				acceptedAnswer: { '@type': 'Answer', text: a },
			})),
		},
	],
};
---

<Base lang={lang} title={c.home.title} description={c.home.description} current="home" jsonLd={jsonLd}>
	<section class="hero">
		<div class="wrap">
			<h1>{c.home.h1.map((l) => <span>{l}</span>)}</h1>
			<p class="sub">{c.home.sub(platformList)}</p>
			<ul class="points">
				{c.home.points.map((x) => <li>{x}</li>)}
			</ul>
			<div class="actions">
				<a class="btn" href="#pricing">{c.home.ctaPrimary}</a>
				<a class="btn ghost" href={path(lang, 'docs')}>{c.home.ctaSecondary}</a>
				<span class="from muted">{c.home.from(fromPrice)}</span>
			</div>
			<Feed lang={lang} label={c.home.demo} liveLabel={c.home.live} />
			<nav class="platforms" aria-label={c.nav.platforms}>
				{PLATFORMS.map((p) => <a class={`p-${p.id}`} href={path(lang, p.slug)}>{p.name}</a>)}
			</nav>
		</div>
	</section>

	<section>
		<div class="wrap">
			<h2>{c.code.head}</h2>
			<p class="muted intro">{c.code.intro}</p>
			{DEMO_WS_URL && (
				<p class="try">
					{c.home.try} <code>npx wscat -c {DEMO_WS_URL}</code>
				</p>
			)}
			<UrlBuilder lang={lang} />
			<CodeTabs lang={lang} />
		</div>
	</section>

	<Pricing lang={lang} />

	<section class="faq">
		<div class="wrap">
			<h2>{c.faq.head}</h2>
			{c.faq.items.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
		</div>
	</section>
</Base>
