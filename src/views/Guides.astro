---
// The list of guides in a language.
import Base from '../layouts/Base.astro';
import { GUIDES_PATH, guidePage, guides } from '../guides';
import { t, path, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const c = t[lang].guides;
const list = await guides(lang);
const day = (d: Date) => new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(d);
---

<Base lang={lang} title={c.title} description={c.description} page={GUIDES_PATH[lang]} otherPage={GUIDES_PATH[other]} current="guides">
	<section class="hero">
		<div class="wrap">
			<h1>{c.h1}</h1>
			<p class="sub">{c.sub}</p>
			<ul class="list">
				{
					list.map((g) => (
						<li>
							<a href={path(lang, guidePage(lang, g.data.slug))}>{g.data.h1}</a>
							<p class="muted">{g.data.description}</p>
							<time class="muted" datetime={g.data.published.toISOString().slice(0, 10)}>{day(g.data.published)}</time>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Base>

<style>
	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		max-width: 720px;
	}
	.list li {
		border-top: 1px solid var(--line);
		padding: 20px 0;
	}
	.list a {
		font-weight: 600;
		text-decoration: none;
	}
	.list a::before {
		content: '> ';
		color: var(--accent);
	}
	.list p {
		font-size: 14px;
		margin: 6px 0 4px;
	}
	.list time {
		font-size: 12px;
	}
</style>
